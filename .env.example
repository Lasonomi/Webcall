# Docker Compose settings
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=

MYSQL_DATABASE=webcall
MYSQL_USER=webcall
MYSQL_PASSWORD=webcallpass
MYSQL_ROOT_PASSWORD=change-this-root-password
FRONTEND_PORT=5173

# Optional: override the backend DSN completely.
# MYSQL_DSN=webcall:webcallpass@tcp(mysql:3306)/webcall?parseTime=true&charset=utf8mb4&loc=UTC
